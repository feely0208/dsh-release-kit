{
  "name": "@deepwhale-cn/dsh-release-kit",
  "version": "0.1.0",
  "description": "插件目录的发布自动化准备：目录扫描与 pack 预检、版本号 bump、发布命令清单生成——只生成不执行 publish",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "skill",
    "发布",
    "版本",
    "npm",
    "工具箱"
  ],
  "files": [
    "lib",
    "skill",
    "bin",
    "cordis.patch.yml",
    "tests/fixtures",
    "README.md"
  ],
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-release-kit": "bin/cli.mjs"
  },
  "engines": {
    "dsh": ">=0.1.0-rc.6 <0.3.0",
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-skill": "*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feely0208/dsh-release-kit.git"
  },
  "homepage": "https://deepwhale.org.cn/plugins.html",
  "bugs": {
    "url": "https://github.com/feely0208/dsh-release-kit/issues"
  },
  "dependencies": {
    "@deepwhale-cn/dsh-guard-core": "^0.10.1"
  }
}